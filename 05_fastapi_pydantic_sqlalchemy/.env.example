# ==============================================================================
# Environment Configuration Template (Copy to .env)
# ==============================================================================

PROJECT_NAME="FastAPI Store & Catalog API"
VERSION="1.0.0"
DESCRIPTION="Production-grade asynchronous REST API built with FastAPI, Pydantic V2, SQLAlchemy 2.0, and PostgreSQL"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Connection (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=fastapi_store_db
DB_USER=postgres
DB_PASSWORD=
DB_ECHO=false

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000"]
