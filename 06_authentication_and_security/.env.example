# ==============================================================================
# DAY 6: AUTHENTICATION & SECURITY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Project Metadata
PROJECT_NAME="FastAPI Authentication & Security API"
VERSION="1.0.0"
DESCRIPTION="Production-grade FastAPI with passlib bcrypt, python-jose JWT, OAuth2, RBAC, and CORS"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL 16 on port 5433)
DB_HOST="127.0.0.1"
DB_PORT=5433
DB_NAME="fastapi_store_db"
DB_USER="postgres"
DB_PASSWORD=""
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security & JWT Configuration
SECRET_KEY="generate-with-openssl-rand-hex-32-for-production"
REFRESH_SECRET_KEY="generate-with-openssl-rand-hex-32-for-refresh-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
