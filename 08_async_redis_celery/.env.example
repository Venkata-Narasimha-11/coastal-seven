# Application Settings
PROJECT_NAME="Day 8: Async, Redis & Celery Hub"
DEBUG=True
API_V1_STR=/api/v1

# Redis Configuration
# If local Redis is running, use redis://localhost:6379/0
# If Redis is unavailable, the application gracefully uses fakeredis in memory
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT=2.0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# Rate Limiter Defaults (Sliding Window)
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=10

# Cache TTL Defaults
CACHE_DEFAULT_TTL_SECONDS=60
