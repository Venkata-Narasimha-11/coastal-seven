    {
      "name": "4. Task Workflow & State Machine",
      "item": [
        {
          "name": "Transition: TODO -> IN_PROGRESS",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{developer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"notes\": \"Developer started implementation.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{task_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{task_id}}", "status"]
            }
          }
        },
        {
          "name": "Illegal Transition: IN_PROGRESS -> COMPLETED (Expect 400)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{developer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"notes\": \"Attempting to bypass code review.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{task_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{task_id}}", "status"]
            }
          }
        },
        {
          "name": "Transition: IN_PROGRESS -> REVIEW",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{developer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"review\",\n  \"notes\": \"Pull Request #12 opened for peer review.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{task_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{task_id}}", "status"]
            }
          }
        },
        {
          "name": "Approve & Complete: REVIEW -> COMPLETED (Manager)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{manager_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"notes\": \"Peer review passed with flying colors. Deployed to production.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{task_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{task_id}}", "status"]
            }
          }
        },
        {
          "name": "Reopen Completed Task (Manager)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{manager_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"notes\": \"Reopened to handle regression reported by QA.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{task_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{task_id}}", "status"]
            }
          }
        },
        {
          "name": "Assign Task to Member",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{manager_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignee_id\": 5,\n  \"notes\": \"Assigned to Diana for backend optimization.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{task_id}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{task_id}}", "assign"]
            }
          }
        },
        {
          "name": "Get Task Audit History Timeline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{manager_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{task_id}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{task_id}}", "history"]
            }
          }
        }
      ]
    },
