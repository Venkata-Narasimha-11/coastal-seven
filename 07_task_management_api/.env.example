# ==============================================================================
# DAY 7 - MINI-PROJECT 2: TASK MANAGEMENT REST API
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

PROJECT_NAME="Enterprise Task Management REST API"
VERSION="1.0.0"
DESCRIPTION="Production-grade Task Management API with JWT Auth, RBAC, Status Workflow, Filtering & Pagination, Alembic Migrations, and Postman Collection."
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL)
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_NAME="task_management_api_db"
DB_USER="postgres"
DB_PASSWORD=""
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

USE_SQLITE_FALLBACK=false
SQLITE_DB_PATH="task_management.db"

# Security & JWT Authentication Configuration
SECRET_KEY="replace-with-a-very-long-random-string-in-production"
REFRESH_SECRET_KEY="replace-with-another-long-random-string-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Administrator Bootstrapping
FIRST_SUPERUSER_EMAIL="admin@taskmanager.io"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"
FIRST_SUPERUSER_USERNAME="admin"

BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
